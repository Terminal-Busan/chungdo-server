# Copy to .env and run:
# python -m uvicorn main:app --reload --port 8000 --env-file .env
# PostgreSQL connection URL. Use sslmode=verify-full for Azure.
DATABASE_URL=

# Official Gov24 API key (decoded or URL-encoded).
GOV24_API_KEY=
# Server-side Copilot authentication. GITHUB_TOKEN is also accepted.
COPILOT_GITHUB_TOKEN=
COPILOT_MODEL=
# Deployed frontend origin; localhost:3000 is always allowed.
FRONT_URL=
# Explicit demo mode only. Production never returns demo policies.
WELFARE_DEMO_MODE=false
