# Default entry: python -m uvicorn main:app --reload --port 8000 --env-file .env
# PostgreSQL connection URL. Use sslmode=verify-full for Azure.
DATABASE_URL=
FRONT_URL=http://localhost:3000

# Both names are accepted by the default backend; use either one.
GOV24_API_KEY=
GOV24_SERVICE_KEY=

# Server-side GitHub Copilot authentication. GITHUB_TOKEN is also accepted.
COPILOT_GITHUB_TOKEN=
# Optional: empty uses the SDK default model.
COPILOT_MODEL=
# Local development only: allow existing Copilot login when no token is supplied.
COPILOT_ENABLED=false

# Explicit demo mode for the default app/ backend only.
WELFARE_DEMO_MODE=false

# Optional aggregate HTTP/agent metrics; no request bodies, URLs or personal data.
APPLICATIONINSIGHTS_CONNECTION_STRING=
