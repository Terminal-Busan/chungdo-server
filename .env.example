# Local: python -m uvicorn main:app --reload --port 8000 --env-file .env
# PostgreSQL is required on Azure. Use sslmode=verify-full for Azure PostgreSQL.
# Local development defaults to ./welfare.db (SQLite) if this is empty.
DATABASE_URL=
FRONT_URL=http://localhost:3000

# Government24 v3 service key issued by data.go.kr (decoded or URL-encoded).
GOV24_SERVICE_KEY=

# GitHub Copilot SDK authentication. Keep this on the backend only.
COPILOT_GITHUB_TOKEN=
# Optional model name. Empty uses the SDK's default model.
COPILOT_MODEL=
# Set true to use local Copilot login instead of an explicit token.
# With no token and false, analysis returns rule-based fallback explanations.
COPILOT_ENABLED=false
